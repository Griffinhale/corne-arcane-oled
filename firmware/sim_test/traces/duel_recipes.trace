# M6 spell recipes: element + modifier variety, a warded bolt, and an
# inactivity expiry gap. Row field is the physical row class (0 top, 1 home,
# 2 bottom, 3 thumb); the recipe compiler reads it directly. Events are in
# non-decreasing tick order (the runner consumes them as the tick advances).
version 1
seed 7

# Left rolls top/home/top while held -> FROST/SWIFT bolt (fast, dir 6).
# Right hammers the thumb row x3 -> VOID/HEAVY bolt (slow, dir 3).
@10  press   L 0 0
@10  press   R 3 0
@11  press   L 1 0
@11  press   R 3 1
@12  press   L 0 1
@12  press   R 3 2
@16  release L 0 0
@16  release L 1 0
@16  release L 0 1
@16  release R 3 0
@16  release R 3 1
@16  release R 3 2

# Left casts a plain FORCE/NONE bolt (single home key) ...
@80  press   L 1 2
@83  release L 1 2
# ... and the right wizard wards in its deflect window (bolt spawns ~90,
# doorstep ~148/149): a keydown here raises the shield in time.
@139 press   R 1 3
@142 release R 1 3

# Long silence: the next left burst starts from a clean accumulator.
@210 press   L 2 0
@211 press   L 2 1
@215 release L 2 0
@215 release L 2 1

@320 end
