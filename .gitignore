# The desktop product's native library (rebuilt by `make city-lib`)
desktop/libcornearcane.so

# The browser shell's module (rebuilt by `make web-lib`) and the scratch
# directory the parity gate renders both sides into.
web/duel_city.wasm
web/tools/.parity/
/.scratch/
artifacts/release/*.map
# Preserved local planning history, signed acceptance records, and rollback
# evidence. These are working records of how the project got here rather than
# documentation of what it currently is, so they stay on disk and out of the
# repository. Photo/video captures stay local until a curated set is worth
# publishing; remove a line below (or `git add -f`) to version one.
docs/archive/
docs/evidence/
artifacts/m11-gallery/
artifacts/m11.1-baseline/
artifacts/m11.1-candidate/
artifacts/m13/*.map
*.o

# Firmware build outputs
*.uf2
*.bin
*.elf

# Nix build result symlinks
/result
/result-*

# Editor / OS noise
*~
.DS_Store

# Agent worktrees (auto-managed)
.claude/worktrees/

# Serena code-intelligence cache
.serena/

# Python tool caches
/.mypy_cache/
/.ruff_cache/

# Python bytecode
__pycache__/

# The Swift package's build tree and the directory the third parity leg
# renders both sides into.
.build/
apple/tools/.parity/
