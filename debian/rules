#!/usr/bin/make -f

%:
	dh $@

# Only the city app's native library is built; the firmware simulation suites
# behind the top-level Makefile's default target are not shipped.
override_dh_auto_build:
	$(MAKE) city-lib

override_dh_auto_clean:
	$(MAKE) -C desktop clean

override_dh_auto_test:
	cd host && ./run_tests.sh

# host/Makefile is the single definition of the install layout; host/package.nix
# drives the same target with PREFIX=$(out).
override_dh_auto_install:
	$(MAKE) -C host install \
		DESTDIR=$(CURDIR)/debian/corne-arcane-host \
		PREFIX=/usr \
		PYTHON=/usr/bin/python3
