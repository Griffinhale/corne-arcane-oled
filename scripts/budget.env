# Firmware resource budget, sourced by scripts/release_budget.sh and by the
# firmware workflows. Plain KEY=value lines only: this is read by sh.
#
# Figures move with the compiler by several hundred flash bytes, so every
# limit here is measured against one ARM toolchain, the one pinned below. CI
# installs exactly that archive; release-budget refuses an image whose ELF
# names a different compiler, unless ALLOW_UNPINNED_TOOLCHAIN=1.
ARM_GCC_VERSION=15.2.rel1
ARM_GCC_COMMENT='Arm GNU Toolchain 15.2.Rel1'
ARM_GCC_URL=https://developer.arm.com/-/media/Files/downloads/gnu/15.2.rel1/binrel/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi.tar.xz
ARM_GCC_SHA256=597893282ac8c6ab1a4073977f2362990184599643b4c5ee34870a8215783a16

# The 88 KiB flash ceiling, static RAM, the 96 KiB hard stop and the 8 KiB
# reserve below it.
FLASH_LIMIT=90112
RAM_LIMIT=16496
HARD_STOP=98304
RESERVE_MIN=8192

# Static RAM may grow at most RAM_GROWTH_ALLOWANCE bytes past each image's
# baseline.
RELEASE_RAM_BASELINE=13464
DIAGNOSTIC_RAM_BASELINE=13576
RAM_GROWTH_ALLOWANCE=512
