# Install layout for the optional Corne Arcane host daemon.
#
# This file is the single definition of where everything lands. host/package.nix
# and debian/rules both drive this target, so the Nix and Debian installs cannot
# drift apart. Nothing here is Nix- or Debian-specific: the three variables below
# are the only difference between them.
#
#   PREFIX   installation prefix       Debian: /usr        Nix: $out
#   DESTDIR  staging root              Debian: debian/tmp  Nix: empty
#   PYTHON   interpreter the commands exec
#
# PREFIX is substituted into generated files, DESTDIR is not: a staged install
# must still name the path the files will finally occupy.

PREFIX  ?= /usr/local
DESTDIR ?=
PYTHON  ?= /usr/bin/python3

BINDIR     = $(PREFIX)/bin
LIBDIR     = $(PREFIX)/lib/corne-arcane-host
DATADIR    = $(PREFIX)/share
UNITDIR    = $(PREFIX)/lib/systemd/user
MOZILLADIR = $(PREFIX)/lib/mozilla/native-messaging-hosts
UDEVDIR    = $(PREFIX)/lib/udev/rules.d

# The systemd unit and the Firefox manifest go under lib/, not share/: both are
# found by another program globbing a search path rather than by a human reading
# the README. NixOS globs {etc,lib}/systemd/user and {etc,lib}/udev/rules.d, the
# nixpkgs Firefox wrapper globs lib/mozilla/native-messaging-hosts, and Debian
# uses the same three directories under /usr.

GNOME_UUID = corne-arcane-focus@griffinhale.github.io

# Public command name suffix : implementing module. corne-arcane-$(suffix) is a
# stable public identity; add to this list rather than writing install rules.
COMMANDS = \
	host:daemon \
	event:event \
	diagnostics:diagnostics \
	browser-bridge:browser_bridge \
	vial:vial_launcher \
	focus-x11:focus_x11

.PHONY: install install-lib install-commands install-units install-assets install-udev

install: install-lib install-commands install-units install-assets install-udev

install-lib:
	install -d "$(DESTDIR)$(LIBDIR)"
	cp -r arcane_host "$(DESTDIR)$(LIBDIR)/"
	find "$(DESTDIR)$(LIBDIR)" -name '__pycache__' -type d -prune -exec rm -rf {} +
	find "$(DESTDIR)$(LIBDIR)" -type f -name '*.py' -exec chmod 0644 {} +

# Each command is a small stub that puts the private library directory on the
# path and calls the module's existing main(). Generating them from COMMANDS
# keeps the five public names declared in exactly one place.
install-commands:
	install -d "$(DESTDIR)$(BINDIR)"
	@for entry in $(COMMANDS); do \
		suffix=$${entry%%:*}; module=$${entry##*:}; \
		target="$(DESTDIR)$(BINDIR)/corne-arcane-$$suffix"; \
		printf '#!%s\n' '$(PYTHON)' > "$$target"; \
		printf '"""Generated by host/Makefile; edit that, not this."""\n' >> "$$target"; \
		printf 'import sys\n\n' >> "$$target"; \
		printf 'sys.path.insert(0, "%s")\n' '$(LIBDIR)' >> "$$target"; \
		printf 'from arcane_host.%s import main\n\n' "$$module" >> "$$target"; \
		printf 'raise SystemExit(main())\n' >> "$$target"; \
		chmod 0755 "$$target"; \
		echo "  generated corne-arcane-$$suffix -> arcane_host.$$module"; \
	done

# Generated from .in templates so ExecStart follows PREFIX. The focus producer
# is opt-in: it is installed but never enabled, because KWin and GNOME Shell
# report focus from inside the compositor and need no helper.
UNITS = corne-arcane-host corne-arcane-focus-x11

install-units:
	install -d "$(DESTDIR)$(UNITDIR)"
	@for unit in $(UNITS); do \
		sed 's|@PREFIX@|$(PREFIX)|g' "systemd/$$unit.service.in" \
			> "$(DESTDIR)$(UNITDIR)/$$unit.service"; \
		chmod 0644 "$(DESTDIR)$(UNITDIR)/$$unit.service"; \
		echo "  generated $$unit.service"; \
	done

install-assets:
	install -d "$(DESTDIR)$(MOZILLADIR)"
	sed 's|@PREFIX@|$(PREFIX)|g' firefox/io.github.griffinhale.corne_arcane.json.in \
		> "$(DESTDIR)$(MOZILLADIR)/io.github.griffinhale.corne_arcane.json"
	chmod 0644 "$(DESTDIR)$(MOZILLADIR)/io.github.griffinhale.corne_arcane.json"
	install -d "$(DESTDIR)$(DATADIR)/kwin/scripts/cornearcane"
	cp -r kwin/contents kwin/metadata.json "$(DESTDIR)$(DATADIR)/kwin/scripts/cornearcane/"
	install -d "$(DESTDIR)$(DATADIR)/gnome-shell/extensions/$(GNOME_UUID)"
	install -m 0644 gnome/metadata.json gnome/extension.js \
		"$(DESTDIR)$(DATADIR)/gnome-shell/extensions/$(GNOME_UUID)/"
	install -D -m 0644 zsh/corne-arcane.zsh \
		"$(DESTDIR)$(DATADIR)/corne-arcane/zsh/corne-arcane.zsh"
	install -D -m 0644 bash/corne-arcane.bash \
		"$(DESTDIR)$(DATADIR)/corne-arcane/bash/corne-arcane.bash"
	install -D -m 0644 fish/conf.d/corne-arcane.fish \
		"$(DESTDIR)$(DATADIR)/corne-arcane/fish/conf.d/corne-arcane.fish"
	install -d "$(DESTDIR)$(DATADIR)/corne-arcane/firefox"
	install -m 0644 firefox/manifest.json firefox/background.js firefox/scroll.js \
		"$(DESTDIR)$(DATADIR)/corne-arcane/firefox/"
	install -D -m 0644 desktop/corne-arcane-vial.desktop \
		"$(DESTDIR)$(DATADIR)/applications/corne-arcane-vial.desktop"

install-udev:
	install -D -m 0644 udev/60-corne-arcane.rules \
		"$(DESTDIR)$(UDEVDIR)/60-corne-arcane.rules"
